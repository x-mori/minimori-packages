#!/usr/bin/env ruby
# frozen_string_literal: true

# Copies standard input to the system clipboard, for example: echo hello | xmori-copy
require 'x_mori/copy_to_clipboard_cli'

begin
  XMori::CopyToClipboardCli.copy($stdin.binmode.read)
rescue RuntimeError => e
  warn "xmori-copy: #{e.message}"
  exit 1
end
